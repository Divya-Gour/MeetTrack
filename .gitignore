# Dependencies
node_modules/
*/node_modules/
**/node_modules/

# Production build output
dist/
dist-ssr/
*/dist/
**/dist/
build/
*.tsbuildinfo

# Environment and Secrets (CRITICAL: Never commit .env or secrets)
.env
.env.*
*.env
**/.env
**/.env.*
server/.env
server/.env.*
client/.env
client/.env.*
*.local

# Whitelist safe example config templates ONLY
!.env.example
!server/.env.example
!client/.env.example
!client.env.example

# Secret keys, credentials and certificates
*.pem
*.key
*.cert
*.crt
*.pfx
*.pkcs12
*.id_rsa
*.id_ed25519
id_rsa*
id_ed25519*
credentials.json
secrets.json
service-account*.json

# Databases and storage dumps
*.sqlite
*.sqlite3
*.db
/dump/
/data/
/server/data/

# Logs
logs
*.log
npm-debug.log*
yarn-debug.log*
yarn-error.log*
pnpm-debug.log*

# Editor & OS files
.vscode/*
!.vscode/extensions.json
.idea/
.DS_Store
Thumbs.db
*.suo
*.ntvs*
*.njsproj
*.sln
*.sw?
