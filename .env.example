# MeetTrack Server Configuration
PORT=5000
NODE_ENV=development
APP_URL=http://localhost:5173
MONGODB_URI=mongodb://localhost:27017/meettrack
SESSION_SECRET=meettrack_enterprise_session_secret_min_32_characters_long

# Gemini API Configuration
# Get your API key at https://aistudio.google.com/
# NEVER expose this key to the client or commit it to version control.
GEMINI_API_KEY=your_gemini_api_key_here
GEMINI_MODEL=gemini-2.5-flash

# Optional SMTP Settings for Live Email Invitations
# If left blank, invite links are surfaced directly in the UI for the admin to copy
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM="MeetTrack Governance <noreply@meettrack.org>"

